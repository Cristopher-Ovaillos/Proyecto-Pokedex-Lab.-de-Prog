example {
  name: query-level
  description: recopila los movimientos que aprende <level=num
  
  request: {
    url: http://192.168.1.59:3000/api/enciclopedia/pokemon/1/movimientos?level=20
    method: GET
    mode: none
    params:query: {
      level: 20
    }
  }
  
