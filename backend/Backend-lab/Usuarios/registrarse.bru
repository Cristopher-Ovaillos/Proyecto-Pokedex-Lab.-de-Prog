meta {
  name: registrarse
  type: http
  seq: 1
}

post {
  url: http://localhost:3000/api/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "nombre_usuario": "admin123",
    "email": "admin@example.com",
    "contrasenia": "admin123"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: example (1)
  
  request: {
    url: http://localhost:3000/api/auth/register
    method: POST
    mode: json
    body:json: {
      {
        "nombre_usuario": "AshKetchum",
        "email": "ash@kanto.com",
        "contrasenia": "pikachu123"
      }
    }
  }
  
  response: {
    headers: {
      cross-origin-opener-policy: same-origin
      cross-origin-resource-policy: same-origin
      origin-agent-cluster: ?1
      referrer-policy: no-referrer
      strict-transport-security: max-age=31536000; includeSubDomains
      x-content-type-options: nosniff
      x-dns-prefetch-control: off
      x-download-options: noopen
      x-frame-options: SAMEORIGIN
      x-permitted-cross-domain-policies: none
      x-xss-protection: 0
      access-control-allow-origin: *
      content-type: application/json; charset=utf-8
      content-length: 255
      etag: W/"ff-u5w/uLQ090WznJwpqVlA34X23OI"
      date: Tue, 13 Jan 2026 22:48:37 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "Usuario creado exitosamente",
          "data": {
            "id_usuario": 1,
            "nombre_usuario": "AshKetchum",
            "email": "ash@kanto.com",
            "fecha_creacion": "2026-01-13T22:48:37.251Z",
            "contrasenia": "$2b$10$61Q.HGs9tXFACYRVawM8/.Jkr2bSB0Ycc4FeaMXbtjNYVc3zp2BKe"
          }
        }
      '''
    }
  }
}

