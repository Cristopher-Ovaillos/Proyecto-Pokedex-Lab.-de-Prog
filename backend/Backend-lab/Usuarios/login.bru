meta {
  name: login
  type: http
  seq: 2
}

post {
  url: http://192.168.1.59:3000/api/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "nombre_usuario": "admin123",
    "contrasenia": "admin123"
  }
  
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: example
  
